// Firestore 보안 규칙 — 「블록 딜레마」 순위표
//
// 이 파일을 main 에 올리면 GitHub 자동 작업(.github/workflows/firebase.yml)이 Firebase 에 적용한다.
// Firebase 콘솔의 "규칙" 화면에서 직접 고치면 다음 적용 때 이 파일 내용으로 덮어써지니, 여기서만 고칠 것.
//
// 1단계 검사(올릴 때 바로 거르기)를 여기서 한다:
//   - 익명 로그인한 본인 문서만, 정해진 칸만, 닉네임 2~10자
//   - 점수가 턴 수로 가능한 상한(engine.js 의 maxScore 와 같은 식)을 넘으면 거부
//   - 같은 순위표 기록은 더 높은 점수로만, 10초에 한 번까지
//   - 시즌(한국 시간 기준 한 달)마다 새 기록. 올리는 순간의 달이 아니면 거부
//   - 칭호(titles)는 관리자 도구만 주고, 본인은 어떤 칭호를 달지(pick)만 바꿀 수 있다
// 2단계(리플레이로 다시 돌려 보고 지우기)는 tools/verify-scores.mjs 가 밤마다 한다.
// 3단계(관리자 삭제)는 admin.html — either21or@gmail.com 구글 로그인만 지울 수 있다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'either21or@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function mult(level) {
      return level == 1 ? 1.0 : (level == 2 ? 1.5 : (level == 3 ? 2.0 : 3.0));
    }
    // 턴당 가장 비싼 블록 32점 + 줄 보너스 10×6²×연속(≤턴 수), 여기에 난이도 배율
    function maxScore(level, t) {
      return mult(level) * (32 * t + 180 * t * (t + 1));
    }

    // 지금 시즌 "2026-09" (한국 시간 = UTC+9)
    function seasonNow() {
      let t = request.time + duration.value(9, 'h');
      let m = t.month();
      return string(t.year()) + '-' + (m < 10 ? '0' + string(m) : string(m));
    }

    function validScore(d) {
      return d.keys().hasOnly(['uid', 'name', 'score', 'mode', 'level', 'turns', 'seed', 'slots', 'v', 'log', 'status', 'at', 'season'])
        && d.keys().hasAll(['uid', 'name', 'score', 'mode', 'level', 'turns', 'seed', 'slots', 'v', 'log', 'status', 'at', 'season'])
        && d.season == seasonNow()
        && validCore(d);
    }
    // 시즌 도입 전 앱(1.0.17 등 — 비공개 테스트가 한동안 이 버전)이 올리는 모양: season 없음, id = uid_모드_난이도.
    // 받아 두면 밤 검증(tools/verify-scores.mjs)이 올린 달의 시즌 문서로 옮긴다. 옛 앱이 다 사라지면 지워도 됨.
    function validLegacy(d) {
      return d.keys().hasOnly(['uid', 'name', 'score', 'mode', 'level', 'turns', 'seed', 'slots', 'v', 'log', 'status', 'at'])
        && d.keys().hasAll(['uid', 'name', 'score', 'mode', 'level', 'turns', 'seed', 'slots', 'v', 'log', 'status', 'at'])
        && validCore(d);
    }
    function validCore(d) {
      return d.uid == request.auth.uid
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 10
        && !claimedByOther(d.name)
        && d.mode in ['35', '16']
        && d.level is int && d.level >= 1 && d.level <= 4
        && d.turns is int && d.turns >= 1 && d.turns <= 5000
        && d.score is int && d.score > 0 && d.score <= maxScore(d.level, d.turns)
        && d.seed is int
        && d.slots in [1, 2]
        && d.v is int
        && d.log is string && d.log.size() <= 300000
        && d.status == 'pending'
        && d.at == request.time;
    }

    // 구글 연동한 사람이 선점한 닉네임이면, 그 주인만 그 닉네임으로 점수를 올릴 수 있다
    function claimedByOther(name) {
      let p = /databases/$(database)/documents/names/$(name.lower());
      return exists(p) && get(p).data.uid != request.auth.uid;
    }

    function ownId(id) {
      return id == request.auth.uid + '_' + request.resource.data.mode + '_' + string(request.resource.data.level)
        + '_' + request.resource.data.season;
    }

    function legacyId(id) {
      return id == request.auth.uid + '_' + request.resource.data.mode + '_' + string(request.resource.data.level);
    }
    function validWrite(id) {
      return request.auth != null
        && ((ownId(id) && validScore(request.resource.data)) || (legacyId(id) && validLegacy(request.resource.data)));
    }

    match /scores/{id} {
      allow read: if true;
      allow create: if validWrite(id);
      allow update: if validWrite(id)
        && request.resource.data.score > resource.data.score
        && request.time > resource.data.at + duration.value(10, 's');
      allow delete: if isAdmin();
    }

    // 칭호: titles/{uid} = { list: [{s, b, r}], pick }. list 는 관리자 도구(서버 권한)만 쓴다.
    match /titles/{uid} {
      allow read: if true;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pick'])
        && request.resource.data.pick is int
        && request.resource.data.pick >= -1
        && request.resource.data.pick < resource.data.list.size();
      allow create, delete: if isAdmin();
    }

    // 닉네임 선점: 문서 id = 닉네임 소문자. 구글 계정을 연동한 사람만 만들 수 있고, 본인(또는 관리자)만 놓아줄 수 있다.
    match /names/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && 'google.com' in request.auth.token.firebase.identities
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 10
        && key == request.resource.data.name.lower();
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
